#!/usr/bin/env sh

file="$1"
w="$2"
h="$3"
x="$4"
y="$5"

draw() {
  # timg -C -g "${w}x${h}" "$file" </dev/null >/dev/tty
  kitten icat --stdin no --transfer-mode memory --place "${w}x${h}@${x}x${y}" "$file" </dev/null >/dev/tty
  exit 1
}

case "$(file -Lb --mime-type "$file")" in
  text/* | application/json | application/javascript)
    bat --color=always --style=plain --pager=never "$file"
    exit 0
    ;;
  image/*)
    draw "$file"
    ;;
  video/*)
    ffmpegthumbnailer -i "$file" -o /tmp/thumb.png -s 512 2>/dev/null
    draw "/tmp/thumb.png"
    ;;
  application/pdf)
    mutool draw -o "/tmp/pdf_preview_$$.png" -w 512 "$file" 1 2>/dev/null
    draw "/tmp/pdf_preview_$$.png"
    ;;
  *)
    pistol "$file"
    exit 0
    ;;
esac
